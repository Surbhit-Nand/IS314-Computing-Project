CLERK_SECRET_KEY=
API_PORT=8787
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=
STRIPE_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# AI animal search (Google Gemini text embeddings). Backend-only: never add a
# VITE_* version of this key, VITE_* values are shipped to the browser.
# Get one at https://aistudio.google.com/apikey. With this left blank the API
# still starts and every other feature works - only AI search reports itself
# unavailable.
GEMINI_API_KEY=
# Optional overrides. The embedding width is fixed in
# server/src/config/aiSearchConfig.ts and must match the database column, so it
# is deliberately NOT configurable here.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# AI_SEARCH_RESULT_LIMIT=10
# AI_SEARCH_MIN_SIMILARITY=0
# DEV ONLY. Skips the staff-role check locally. Leave unset/false - never
# set to true outside your own machine, and never in a deployed environment.
DEV_BYPASS_AUTH=false
