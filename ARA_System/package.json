{
  "name": "ara-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "tsx server/src/server.ts",
    "server:check": "tsc -p server/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "db:seed:animals": "tsx server/src/db/seed-animals.ts",
    "db:seed:breeds": "tsx server/src/db/seed-breeds.ts",
    "ai:backfill": "tsx server/src/scripts/backfillAnimalEmbeddings.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --import tsx --experimental-test-module-mocks --test \"server/src/**/*.test.ts\" \"src/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.10",
    "@clerk/react": "^6.14.5",
    "@neondatabase/serverless": "^1.1.0",
    "clerk": "^3.1.0",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "multer": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.66.3",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
